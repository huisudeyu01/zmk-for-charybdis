// 引用必要的头文件
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    // 1. 首先定义所有需要的行为
    behaviors {
        // 解决漂移的核心：空闲休眠行为
        slp: sleep_on_idle {
            compatible = "zmk,behavior-sensor-sleep";
            label = "SLEEP_ON_IDLE";
            #sensor-cells = <0>;
            sleep-timeout-ms = <1200>; // 静止1.2秒后休眠
            enable-on-startup;
        };
        
        // 必备：轨迹球校准行为
        tcal: sensor_calibration {
            compatible = "zmk,behavior-sensor-calibration";
            label = "SENSOR_CALIBRATION";
            #sensor-cells = <0>;
        };
        
        // 其他实用行为
        boot: bootloader {
            compatible = "zmk,behavior-bootloader";
            label = "BOOTLOADER";
        };
        
        // 定义一个粘滞层切换，用于鼠标层
        to_mouse: sticky_layer {
            compatible = "zmk,behavior-sticky-key";
            label = "TO_MOUSE";
            #binding-cells = <1>;
            bindings = <&mo>;
            quick-tap-ms = <150>;
        };
    };

    // 2. 配置键盘的传感器（轨迹球）
    &trackball {
        // 防漂移关键配置：绑定休眠行为和滤波器
        triggers {
            trigger = <&slp>;
        };
        pointers-config {
            accel-min = <50>;
            accel-max = <30000>;
        };
        pointers-filter {
            relative-min = <5>;
            relative-max = <100>;
            multiplier = <1>;
        };
        
        // 调整灵敏度和速度
        resolution = <800>; // 降低CPI，防止漂移
        accel-divisor = <8>; // 降低加速度
        scroll-divisor = <6>; // 降低滚动速度
    };

    // 3. 定义键位映射
    keymap {
        compatible = "zmk,keymap";

        // 层 0: 默认层 (QWERTY)
        default_layer {
            bindings = <
                // 左半部分 (主键区)
                &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T
                &kp ESC    &kp A    &kp S    &kp D    &kp F    &kp G
                &kp LSHIFT &kp Z    &kp X    &kp C    &kp V    &kp B
                
                // 左半部分 (拇指键)
                &kp LCTRL  &to_mouse 1  &kp SPACE // 按住中间键切换到鼠标层1

                // 右半部分 (主键区)
                &kp Y      &kp U    &kp I    &kp O    &kp P    &kp BSPC
                &kp H      &kp J    &kp K    &kp L    &kp SEMI &kp SQT
                &kp N      &kp M    &kp COMM &kp DOT  &kp FSLH &kp RSFT
                
                // 右半部分 (拇指键)
                &kp RET    &kp DEL  &kp RALT
            >;
        };

        // 层 1: 鼠标层 (按住左拇指中键激活)
        mouse_layer {
            bindings = <
                // 左半部分 - 鼠标功能
                &none      &none    &none    &none    &none    &none
                &none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none    &none
                &none      &none    &none    &none    &none    &none
                
                // 左拇指键 - 层指示和功能
                &trans     &mo 1    &kp MB1  // 保持按住状态，中间键显示为激活状态

                // 右半部分 - 鼠标滚动和按键
                &none      &none    &none    &none    &none    &none
                &none      &wh_DOWN &wh_UP   &none    &none    &none
                &none      &none    &none    &none    &none    &none
                
                // 右拇指键 - 更多鼠标按键
                &kp MB2    &kp MB3  &trans
            >;
        };

        // 层 2: 功能/导航层 (通过其他键切换，这里未显示切换键，可自行添加)
        nav_layer {
            bindings = <
                // 左半部分 - 系统功能
                &boot      &tcal    &none    &none    &none    &none // 刷机和校准！
                &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &none    &none    &none
                &none      &none    &none    &none    &none    &none
                
                // 左拇指键
                &trans     &mo 2    &trans

                // 右半部分 - 导航键
                &kp HOME   &kp UP   &kp END  &none    &none    &none
                &kp LEFT   &kp DOWN &kp RGHT &none    &none    &none
                &kp PG_UP  &kp PG_DN &none   &none    &none    &none
                
                // 右拇指键
                &trans     &trans   &trans
            >;
        };
    };
};
