#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        CAP {
            bindings = <&kp CAPS>;
            key-positions = <27 53>;
            layers = <0>;
        };

        pre {
            bindings = <&mkp MB4>;
            key-positions = <26 53>;
            layers = <0>;
        };

        next {
            bindings = <&mkp MB5>;
            key-positions = <28 53>;
            layers = <0>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <15 53>;
            layers = <0>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <39 53>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_1 {
            bindings = <
&kp ESCAPE    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5          &kp NUMBER_6      &kp N7         &kp N8     &kp N9      &kp N0        &kp DEL
&kp F2        &kp Q         &kp W         &kp E         &kp R         &kp T           &kp Y             &kp U          &kp I      &kp O       &kp P         &kp BSLH
&kp F4        &kp A         &kp S         &kp D         &kp F         &kp G           &kp H             &kp J          &kp K      &kp L       &mo 1         &kp SEMICOLON
&kp LEFT_ALT  &kp Z         &kp X         &kp C         &kp V         &kp B           &kp N             &kp M          &kp COMMA  &kp PERIOD  &kp QUESTION  &kp TAB
                                          &kp SPACE     &kp ENTER     &kp LEFT_GUI    &kp LEFT_SHIFT    &kp BACKSPACE
                                                        &mkp LCLK     &mkp RCLK       &kp LEFT_CONTROL
            >;

            trackball-bindings = <&tmv_coarse>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans         &trans                  &bootloader      &trans          &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp PAGE_UP    &kp LEFT_PARENTHESIS    &kp RIGHT_ARROW  &kp UP_ARROW    &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp PAGE_DOWN  &kp RPAR                &kp LEFT         &kp DOWN_ARROW  &kp MINUS  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans         &trans                  &trans           &trans          &trans     &trans  &trans  &trans
                        &trans  &trans         &trans                  &trans           &trans
                                &trans         &trans                  &trans
            >;
        };
    };
};
